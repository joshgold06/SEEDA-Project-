# Copy to .env.local and fill in from your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=https://asitutntujffdccykjkx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Research this lead" and "Write with AI" (server only: never put these in a NEXT_PUBLIC_ variable).
# Tavily search key (tavily.com, free plan) and Google Gemini key (aistudio.google.com, free plan).
TAVILY_API_KEY=
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# The daily scan and the triggers feed (server only: never a NEXT_PUBLIC_ variable, never shown on screen or in a video).
# Supabase > Project Settings > API > the "service_role" (secret) key. It bypasses row-level security, so only the server holds it.
SUPABASE_SERVICE_ROLE_KEY=
# Any random string of 16 or more letters and numbers. Vercel sends it as a bearer token when it calls /api/cron/daily.
CRON_SECRET=
