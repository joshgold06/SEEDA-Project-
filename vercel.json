{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 11 * * *" },
    { "path": "/api/cron/insights", "schedule": "20 11 * * *" },
    { "path": "/api/cron/agent?slot=1", "schedule": "40 11 * * *" },
    { "path": "/api/cron/agent?slot=2", "schedule": "0 13 * * *" },
    { "path": "/api/cron/agent?slot=3", "schedule": "0 15 * * *" }
  ]
}
